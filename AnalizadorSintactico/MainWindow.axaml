<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:AnalizadorSintactico.Tabs"
        x:Class="AnalizadorSintactico.MainWindow"
        Title="Calculadora"
        Width="320" Height="560"
        CanResize="False">

  <Window.Styles>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TabItem">
      <Setter Property="Background" Value="#FFE2E8F0"/>
      <Setter Property="Foreground" Value="#FF0F172A"/>
      <Setter Property="BorderBrush" Value="#FF94A3B8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#FFE2E8F0"/>
    </Style>

    <Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="White"/>
    </Style>

    <Style Selector="Button.calc-key">
      <Setter Property="Background" Value="#FF1E293B"/>
      <Setter Property="BorderBrush" Value="#FF334155"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>
    <Style Selector="Button.calc-key:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF1E293B"/>
    </Style>

    <Style Selector="Button.calc-key.operator">
      <Setter Property="Background" Value="#FFF97316"/>
      <Setter Property="BorderBrush" Value="#FFE45D10"/>
    </Style>
    <Style Selector="Button.calc-key.operator:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFF97316"/>
    </Style>

    <Style Selector="Button.calc-key.danger">
      <Setter Property="Background" Value="#FFDC2626"/>
      <Setter Property="BorderBrush" Value="#FFB91C1C"/>
    </Style>
    <Style Selector="Button.calc-key.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFDC2626"/>
    </Style>
  </Window.Styles>

  <Border Margin="16" Padding="16" CornerRadius="16"
          Background="#FFF8FAFC" BorderBrush="#FFD7E0EA" BorderThickness="1">
    <StackPanel Spacing="12">

      <Border Padding="16" CornerRadius="12" Background="#FF0F172A">
        <StackPanel Spacing="4">
          <TextBlock Name="Display" Text="0" FontSize="36"
                     Foreground="White" TextAlignment="Right"/>
          <TextBlock Name="StatusText" Text="" FontSize="16"
                     Foreground="#FFCBD5E1" HorizontalAlignment="Right"/>
        </StackPanel>
      </Border>

      <TabControl>
        <TabItem Header="1">
          <tabs:Expresion/>
        </TabItem>
        <TabItem Header="2">
          <tabs:Historial/>
        </TabItem>
        <TabItem Header="3">
          <tabs:TablaDerivacion/>
        </TabItem>
        <TabItem Header="4">
          <tabs:ArbolDerivacion/>
        </TabItem>
      </TabControl>
    </StackPanel>
  </Border>
</Window>