<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AnalizadorSintactico.MainWindow"
        Title="Calculadora"
        Width="320" Height="560"
        CanResize="False">

  <Window.Styles>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TabItem">
      <Setter Property="Background" Value="#FFE2E8F0"/>
      <Setter Property="Foreground" Value="#FF0F172A"/>
      <Setter Property="BorderBrush" Value="#FF94A3B8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Quitar hover del TabItem -->
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#FFE2E8F0"/>
    </Style>

    <!-- Quitar hover del TabItem seleccionado -->
    <Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="White"/>
    </Style>

    <!-- Base -->
    <Style Selector="Button.calc-key">
      <Setter Property="Background" Value="#FF1E293B"/>
      <Setter Property="BorderBrush" Value="#FF334155"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>
    <!-- Sin hover -->
    <Style Selector="Button.calc-key:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF1E293B"/>
    </Style>

    <Style Selector="Button.calc-key.operator">
      <Setter Property="Background" Value="#FFF97316"/>
      <Setter Property="BorderBrush" Value="#FFE45D10"/>
    </Style>
    <Style Selector="Button.calc-key.operator:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFF97316"/>
    </Style>

    <Style Selector="Button.calc-key.danger">
      <Setter Property="Background" Value="#FFDC2626"/>
      <Setter Property="BorderBrush" Value="#FFB91C1C"/>
    </Style>
    <Style Selector="Button.calc-key.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFDC2626"/>
    </Style>
  </Window.Styles>

  <Border Margin="16" Padding="16" CornerRadius="16"
          Background="#FFF8FAFC" BorderBrush="#FFD7E0EA" BorderThickness="1">
    <StackPanel Spacing="12">

      <Border Padding="16" CornerRadius="12" Background="#FF0F172A">
        <StackPanel Spacing="4">
          <TextBlock Name="Display" Text="0" FontSize="36"
                     Foreground="White" TextAlignment="Right"/>
          <TextBlock Name="StatusText" Text="" FontSize="16"
                     Foreground="#FFCBD5E1" HorizontalAlignment="Right"/>
        </StackPanel>
      </Border>

      <TabControl>
        <TabItem Header="1">
          <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*,*" Margin="0,12,0,0">

            <Button Classes="calc-key danger" Content="AC"     Click="OnClear"     Grid.Row="0" Grid.Column="0" Margin="3"/>
            <Button Classes="calc-key"        Content="("      Click="OnInput"     Grid.Row="0" Grid.Column="1" Margin="3"/>
            <Button Classes="calc-key"        Content=")"      Click="OnInput"     Grid.Row="0" Grid.Column="2" Margin="3"/>
            <Button Classes="calc-key operator" Content="÷"   Click="OnOperator"  Grid.Row="0" Grid.Column="3" Margin="3"/>

            <Button Classes="calc-key" Content="7" Click="OnInput" Grid.Row="1" Grid.Column="0" Margin="3"/>
            <Button Classes="calc-key" Content="8" Click="OnInput" Grid.Row="1" Grid.Column="1" Margin="3"/>
            <Button Classes="calc-key" Content="9" Click="OnInput" Grid.Row="1" Grid.Column="2" Margin="3"/>
            <Button Classes="calc-key operator" Content="x"   Click="OnOperator"  Grid.Row="1" Grid.Column="3" Margin="3"/>

            <Button Classes="calc-key" Content="4" Click="OnInput" Grid.Row="2" Grid.Column="0" Margin="3"/>
            <Button Classes="calc-key" Content="5" Click="OnInput" Grid.Row="2" Grid.Column="1" Margin="3"/>
            <Button Classes="calc-key" Content="6" Click="OnInput" Grid.Row="2" Grid.Column="2" Margin="3"/>
            <Button Classes="calc-key operator" Content="-"   Click="OnOperator"  Grid.Row="2" Grid.Column="3" Margin="3"/>

            <Button Classes="calc-key" Content="1" Click="OnInput" Grid.Row="3" Grid.Column="0" Margin="3"/>
            <Button Classes="calc-key" Content="2" Click="OnInput" Grid.Row="3" Grid.Column="1" Margin="3"/>
            <Button Classes="calc-key" Content="3" Click="OnInput" Grid.Row="3" Grid.Column="2" Margin="3"/>
            <Button Classes="calc-key operator" Content="+"   Click="OnOperator"  Grid.Row="3" Grid.Column="3" Margin="3"/>

            <Button Classes="calc-key"        Content="0"      Click="OnInput"     Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="3"/>
            <Button Classes="calc-key danger" Content="Borrar" Click="OnBackspace" Grid.Row="4" Grid.Column="2"                     Margin="3"/>
            <Button Classes="calc-key"        Content="."      Click="OnInput"     Grid.Row="4" Grid.Column="2" Margin="3"/>
            <Button Classes="calc-key operator" Content="="   Click="OnEquals"    Grid.Row="4" Grid.Column="3" Margin="3"/>

          </Grid>
        </TabItem>

        <TabItem Header="2"/>
        <TabItem Header="3"/>
        <TabItem Header="4"/>
      </TabControl>
    </StackPanel>
  </Border>
</Window>