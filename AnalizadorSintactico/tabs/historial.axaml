<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:tabs="clr-namespace:AnalizadorSintactico.Tabs"
			 x:DataType="tabs:Historial"
						 x:Class="AnalizadorSintactico.Tabs.Historial">
		<StackPanel Spacing="8">
			<TextBlock Text="Historial"
								 FontSize="18"
								 FontWeight="SemiBold"
								 Foreground="#FF0F172A"/>

			<ListBox ItemsSource="{Binding History}"
							 Background="Transparent"
							 BorderThickness="0">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Margin="0,0,0,8"
										Padding="10"
										CornerRadius="10"
										Background="White"
										BorderBrush="#FFE2E8F0"
										BorderThickness="1">
							<TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FF334155"/>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</StackPanel>
</UserControl>
